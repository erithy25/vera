{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Vera",
  "version": "0.5.2",
  "identifier": "app.vera.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm install && npm run dev",
    "beforeBuildCommand": "npm install && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Vera",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://localhost:11434"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "binaries/ocr-helper",
      "binaries/frame-capture",
      "binaries/frame-extract"
    ],
    "macOS": {
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ3NUQxNTJGMzY2M0Q1RTMKUldUajFXTTJMeFZkMXdZa3FUdkNQSEo1YUdjNFJJbDMvRmo2K1RHTVh6MHZlTmNXRDY1cE5TT28K",
      "endpoints": [
        "https://vera-sandy.vercel.app/updater/latest.json"
      ]
    }
  }
}
