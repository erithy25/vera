# Copy this file to ".env.signing" and fill in your real values.
# ".env.signing" is gitignored — never commit your real credentials.
#
# These let `tauri build` sign Vera with your Apple "Developer ID Application"
# certificate and notarize it with Apple, so downloaders never see the
# "Vera is damaged" warning.

# The full signing identity, exactly as shown by:
#   security find-identity -v -p codesigning
# e.g. "Developer ID Application: Erik Thye (AB12CD34EF)"
APPLE_SIGNING_IDENTITY="Developer ID Application: YOUR NAME (TEAMID)"

# Your Apple ID email
APPLE_ID="you@example.com"

# An app-specific password (NOT your normal Apple password). Create one at
# https://appleid.apple.com -> Sign-In and Security -> App-Specific Passwords
APPLE_PASSWORD="xxxx-xxxx-xxxx-xxxx"

# Your 10-character Apple Team ID (the part in parentheses above, also at
# https://developer.apple.com/account -> Membership details)
APPLE_TEAM_ID="TEAMID"
